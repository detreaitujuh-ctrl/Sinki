{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sinki",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "sinkiparfum.my.id",
      "custom_domain": true
    },
    {
      "pattern": "www.sinkiparfum.my.id",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
